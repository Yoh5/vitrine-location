---
import '../styles/polices.css';
import '../styles/sakan.css';
interface Props { titre: string; description?: string; page?: 'logements' | 'espace' | 'connexion' | null; prive?: boolean }
const { titre, description = 'Sakan : logements à louer au Maroc, à la nuit, à la semaine ou au mois. Démonstration.', page = null, prive = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {prive && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1c1712" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href="/polices/big-shoulders-display-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="rue">
      <div class="cadre rue-cadre">
        <a class="enseigne" href={`${base}/`}>
          <span class="enseigne-latin">Sakan</span>
          <span class="enseigne-arabe" lang="ar">سكن</span>
        </a>
        <nav class="nav" aria-label="Navigation">
          <a href={`${base}/`} aria-current={page === 'logements' ? 'page' : undefined}>Logements</a>
          <a href={`${base}/espace/`} aria-current={page === 'espace' ? 'page' : undefined} id="lien-espace">Mon espace</a>
          <span class="essai" id="lien-connexion">Essayer en{' '}<a href={`${base}/connexion/?demo=proprietaire`}>propriétaire</a>{' '}ou{' '}<a href={`${base}/connexion/?demo=locataire`}>locataire</a></span>
          <button type="button" class="sortir" id="sortir" hidden>Sortir</button>
        </nav>
      </div>
    </header>
    <main class="facade" id="principal">
      <slot />
    </main>
    <footer class="pied">
      <div class="cadre">
        <p><strong>Démonstration.</strong> Sakan est fictif : les logements, les personnes et les téléphones sont inventés,
          aucune réservation n’est réelle et aucun paiement n’est pris. Réalisé par Axel Aho, développeur freelance.{' '}
          <a href="https://github.com/Yoh5/vitrine-location" rel="noopener">Code et tests</a></p>
      </div>
    </footer>
    <script>
      import { lireSession, deconnecter } from '../lib/sakan';
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      const connecte = !!lireSession();
      document.getElementById('lien-connexion')!.hidden = connecte;
      document.getElementById('sortir')!.hidden = !connecte;
      document.getElementById('sortir')!.addEventListener('click', () => { deconnecter(); location.href = `${base}/`; });
    </script>
  </body>
</html>
