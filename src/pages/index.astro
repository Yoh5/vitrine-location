---
import Sakan from '../layouts/Sakan.astro';
import Panneau from '../components/Panneau.astro';
import carte from '../data/carte.json';
import { logements } from '../lib/sakan';

const liste = await logements();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { minx, maxy, k, sx } = carte.projection;
const proj = (lng: number, lat: number) => [(lng - minx) * k * sx, (maxy - lat) * sx];
// une épingle par ville ; l'étiquette passe à gauche quand la ville est près du bord droit
const villes = [...new Map(liste.map((l) => [l.ville, l])).values()];
---
<Sakan titre="Sakan · logements à louer au Maroc (démonstration)" page="logements">
  <div class="cadre">
    <h1 class="titre-peint">Des logements à louer,<br />une nuit ne se loue qu’une fois.</h1>
    <p class="chapeau">À la nuit, à la semaine ou au mois : choisissez vos dates sur le calendrier, la base calcule le
      meilleur tarif et le propriétaire répond. Deux demandes sur les mêmes nuits ? Il ne peut en accepter qu’une.</p>

    <div class="catalogue">
      <ul class="panneaux">
        {liste.map((l) => <li><Panneau l={l} /></li>)}
      </ul>

      <aside class="carte-bloc" aria-labelledby="titre-carte">
        <h2 id="titre-carte">Où sont les logements</h2>
        <svg class="carte" viewBox={`0 0 ${carte.largeur} ${carte.hauteur}`} role="group" aria-label="Carte du nord du Maroc avec une épingle par ville">
          <path class="terre" d={carte.chemin} />
          {villes.map((v) => {
            const [x, y] = proj(v.lng, v.lat);
            const gauche = x > carte.largeur * 0.62;
            const nb = liste.filter((l) => l.ville === v.ville).length;
            return (
              <a href={`${base}/logement/${v.slug}/`} class="epingle" aria-label={`${v.ville} : ${nb} logement${nb > 1 ? 's' : ''}`}>
                <circle cx={x} cy={y} r="9" />
                <text x={gauche ? x - 14 : x + 14} y={y + 5} text-anchor={gauche ? 'end' : 'start'}>{v.ville}</text>
              </a>
            );
          })}
        </svg>
        <p class="carte-note">Tracé simplifié d’après Natural Earth (domaine public).</p>
      </aside>
    </div>
  </div>
</Sakan>

<script>
  import { calendrier, jour } from '../lib/sakan';
  // La bande « LOUÉ » se colle sur un panneau quand le logement est pris dans les 7 prochains jours.
  const iso = (d: Date) => d.toISOString().slice(0, 10);
  const auj = iso(new Date());
  const dans7 = iso(new Date(Date.now() + 7 * 864e5));
  document.querySelectorAll<HTMLElement>('[data-logement]').forEach(async (p) => {
    try {
      const prises = await calendrier(Number(p.dataset.logement));
      const proche = prises.find((x) => x.debut < dans7 && x.fin > auj);
      if (!proche) return;
      const b = p.querySelector<HTMLElement>('[data-bande]')!;
      b.textContent = `Loué du ${jour(proche.debut)} au ${jour(proche.fin)}`;
      b.hidden = false;
    } catch { /* le calendrier détaillé reste sur la fiche */ }
  });
</script>
